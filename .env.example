# ======================================
# Dev Monitoring Suite - Environment Variables
# Copy this file to .env for local development
# On Railway, set these in the Variables tab
# ======================================

# --- Database (auto-provided by Railway PostgreSQL plugin) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis (auto-provided by Railway Redis plugin) ---
REDIS_URL=redis://default:password@host:6379

# --- App Settings ---
PORT=3000
NODE_ENV=production
# Generate a strong random string for session security
SESSION_SECRET=change-this-to-a-random-secret-string

# --- Alert Settings (optional) ---
# Email alerts via SMTP (e.g. Gmail, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_FROM_EMAIL=alerts@yourdomain.com
ALERT_TO_EMAIL=you@yourdomain.com

# Webhook alerts (Slack, Discord, etc.)
WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- Monitor Settings ---
# Default check interval in seconds (60 = 1 minute)
DEFAULT_CHECK_INTERVAL=60
# Request timeout in milliseconds
REQUEST_TIMEOUT=10000
# Number of consecutive failures before alerting
ALERT_THRESHOLD=2
